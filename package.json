{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "font-search",
  "title": "Font Search",
  "description": "Search locally installed fonts, as displayed in font book.",
  "icon": "extension-icon.png",
  "author": "almatkai",
  "preferences": [
    {
      "name": "previewText",
      "type": "textfield",
      "required": false,
      "title": "Preview Text",
      "description": "Text to use for font preview",
      "default": "Sphinx of black quartz, judge my vow."
    }
  ],
  "categories": [
    "Design Tools",
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-fonts",
      "title": "Search Fonts",
      "description": "Search locally installed fonts",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.font-search",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/font-search",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/font-search",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
